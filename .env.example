# npm start loads .env.local and .env; exported variables take precedence.
# Neon: run neon deploy to populate DATABASE_URL and DATABASE_URL_UNPOOLED.
# The app prefers DATABASE_URL_UNPOOLED (session locks, migrations and LISTEN).
# NIMBUS_POSTGRES overrides both; uncomment only to use local PostgreSQL:
# NIMBUS_POSTGRES=postgres://nimbus@127.0.0.1:55432/nimbus?sslmode=disable
NIMBUS_RUNTIME_COMMAND=nimbus-agent-runtime
NIMBUS_DEEPSEEK_API_KEY=
NIMBUS_E2B_API_KEY=
NIMBUS_LOG_LEVEL=debug
