{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "verbatimModuleSyntax": true,
    "rootDir": "src",
    "outDir": "dist",
    "types": [
      "node"
    ],
    "noEmitOnError": true
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.json"
  ]
}
