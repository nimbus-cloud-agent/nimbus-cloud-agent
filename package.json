{
  "name": "nimbus-cloud-agent-workspace",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "npm test --workspace nimbus-agent-runtime && node --test scripts/tool-events.test.ts",
    "e2e": "node scripts/e2e.mjs",
    "start": "node scripts/start.mjs",
    "start:background": "node scripts/manage.mjs start",
    "stop": "node scripts/manage.mjs stop",
    "setup:mac": "bash scripts/setup-macos.sh",
    "build": "npm run build:runtime && npm run build --prefix web && go build -trimpath -o bin/nimbus-cloud-agent ./cmd/nimbus",
    "protocol:generate": "node scripts/generate-protocol.ts",
    "protocol:check": "node scripts/generate-protocol.ts --check",
    "build:runtime": "npm run build --workspace nimbus-agent-runtime",
    "pack:runtime": "make pack-runtime"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "playwright": "1.56.1",
    "prettier": "3.6.2",
    "quicktype-core": "26.0.0",
    "typescript": "7.0.2"
  },
  "overrides": {
    "zod": "4.6.7",
    "undici": "8.12.3",
    "@modelcontextprotocol/client": "2.3.0",
    "fflate": "0.8.3"
  },
  "workspaces": [
    "runtime"
  ]
}
